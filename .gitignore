# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Build output: rebuilt by scripts, never committed
build/
target/
dist/
*.deb

# Firmware images are the user's own and never committed, except the permissively licensed ones in bundled-firmware/ that its
# MANIFEST.tsv lists (scripts/check-bundled.py enforces this; docs/FIRMWARE.md). The GPL pack is a SEPARATE repository, FM1-NTT Firmware Pack, beside this one.
*.fwsc
*.fm1save
!bundled-firmware/**/*.fwsc
firmware/
local_firmware*/

# Claude Code local state
# holds this machine's paths (the Docker socket): never public
.claude/settings.json
.claude/settings.local.json
.claude/.cc-writes/
CLAUDE.local.md

# The web build (web/build.sh): the wasm module and its info file are build output
/web/public/fm1ntt-*.wasm
/web/public/build-info.json
/web/public/build-info.json.tmp

# fm1tastik is its own repository (docs/FM1TASTIK.md); its folder is here, ignored, until it is moved out beside this one
/fm1tastik/
